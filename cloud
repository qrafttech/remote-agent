#!/usr/bin/env bash
# cloud: run a Claude Code session on a Docker host from the current branch, and
# get the result back as a draft pull request. One file, three sides: the client
# verbs (build, run, clean) at the bottom, the host verbs (host-*) the client calls
# over SSH, and the session verb the agent container runs.
#
# On the host, $AGENT_ROOT (default /opt/agent) holds this file, agent.yml, the
# Dockerfile, home/ (the agent's $HOME: login, settings, rules, skills), seed/
# (the plugins, read-only) and projects/<project>/: env, cloud.yml, stack.yml,
# repo.git, inputs/ (in transit) and runs/<branch-slug> (the worktree) with its
# siblings <branch-slug>.prompt, .input and .log.
set -euo pipefail

host=${CLOUD_HOST-vps}
root=${AGENT_ROOT:-/opt/agent}
usage() { echo "usage: cloud build | run <prompt | file> | clean" >&2; exit 1; }
# A branch or repository name as one path-safe word: feat/x -> feat-x.
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-'; }
# Sets dir, name, run and worktree for one project and branch. run is the base of the run's files.
locate() {
  project=$1; branch=$2
  dir=$root/projects/$project; name=$project-$(slug "$branch"); run=$dir/runs/$(slug "$branch"); worktree=$run
}
# docker compose for one run: the project's stack.yml when it has one, then its cloud.yml.
compose() {
  AGENT_ROOT=$root PROJECT_DIR=$dir \
    docker compose --project-directory "$dir" -p "$name" $([ ! -f "$dir/stack.yml" ] || echo "-f $dir/stack.yml") -f "$dir/cloud.yml" "$@"
}
# The session's state per `claude agents`: working, blocked, done..., missing, or error when the listing fails.
state_of() { claude agents --json --all | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const a=JSON.parse(s).find(x=>x.id===process.argv[1]);console.log(a?a.state:"missing")})' "$1" 2>/dev/null || echo error; }
# git with the run's identity, for the commit the host makes on the session's behalf.
agent_git() { git -c user.name=agent -c user.email=agent@cloud "$@"; }

case "${1:-}" in
  # host-build: docker build from the shipped Dockerfile. The agent user gets the
  # caller's uid so the host and the container both own what a run writes.
  host-build)
    docker build -q -t agent --build-arg "AGENT_UID=$(id -u)" - < "$root/Dockerfile" >/dev/null && echo "image agent built"
    exit 0 ;;

  # host-check <project> <branch> <has-stack> <origin-url>: refuse a run the host
  # cannot take (no env, no image, no gh login, a container or worktree still
  # holding this branch), before anything is pushed. Creates the bare repository,
  # records where the pull request goes, drops a stack.yml the project no longer has.
  host-check)
    locate "$2" "$3"
    install -d "$dir/runs" "$dir/inputs" && git init -q --bare "$dir/repo.git"
    git -C "$dir/repo.git" config remote.origin.url "$5"
    [ "$4" = 1 ] || rm -f "$dir/stack.yml"
    [ -f "$dir/env" ] || { echo "cloud: write $dir/env on the host first — the app's KEY=value configuration" >&2; exit 1; }
    docker image inspect agent >/dev/null 2>&1 || { echo "cloud: no image — \`cloud build\` first" >&2; exit 1; }
    gh auth token >/dev/null 2>&1 || { echo "cloud: gh is not logged in on the host — \`gh auth login\` then \`gh auth setup-git\` there" >&2; exit 1; }
    [ -z "$(docker ps -aq -f "name=^$name$")" ] && [ ! -e "$worktree" ] || { echo "cloud: the host holds $name — wait for its pull request, or \`cloud clean\` it" >&2; exit 1; }
    exit 0 ;;

  # host-start <project> <branch> <prompt>: the run itself. Cut the worktree on the
  # branch the client pushed, remember its commit, drop the inputs in, start one
  # detached Compose project (sidecars, then the agent container on `cloud
  # session`) and leave host-finish waiting on the container, logging to the run's
  # .log.
  host-start)
    locate "$2" "$3"
    git -C "$dir/repo.git" worktree add -q "$worktree" "$branch"
    git -C "$dir/repo.git" rev-parse "$branch" > "$run.input"
    printf '%s\n' "$4" > "$run.prompt"
    [ ! -d "$dir/inputs/${run##*/}" ] || { cp -a "$dir/inputs/${run##*/}/." "$worktree/" && rm -r "$dir/inputs/${run##*/}"; }
    compose run -d --quiet-pull --name "$name" agent cloud session "$project" "$branch" >/dev/null
    nohup bash "$root/cloud" host-finish "$project" "$branch" > "$run.log" 2>&1 < /dev/null &
    exit 0 ;;

  # host-finish <project> <branch>: the end of the run, detached from the client.
  # When the container exits: commit whatever the session left, push the branch
  # to origin, open the draft pull request or reuse the open one, then host-clean.
  # A failure stops before the cleanup: the commit is on repo.git, the log says why.
  host-finish)
    locate "$2" "$3"
    docker wait "$name" >/dev/null
    agent_git -C "$worktree" add -A
    agent_git -C "$worktree" diff --cached --quiet || agent_git -C "$worktree" commit -qm "run: $branch"
    if [ "$(git -C "$worktree" rev-parse HEAD)" = "$(cat "$run.input")" ]; then echo "no changes on $branch"
    else
      git -C "$worktree" push -q origin "HEAD:refs/heads/$branch"
      repo=$(git -C "$worktree" config remote.origin.url | sed -E 's#.*github\.com[:/]##; s#\.git$##')
      pr=$(gh pr list --repo "$repo" --head "$branch" --json url -q '.[].url' | head -1)
      [ -n "$pr" ] || pr=$(gh pr create --repo "$repo" --draft --head "$branch" --title "$(head -1 "$run.prompt" | cut -c1-72)" --body-file "$run.prompt")
      echo "pull request $pr"
    fi
    bash "$root/cloud" host-clean "$project" "$branch"
    exit 0 ;;

  # host-clean <project> <branch>: remove the container, the Compose project with
  # its volumes, the worktree and the run's files, keeping the log. Exit 3 means
  # refused with everything kept: still running, or uncommitted work in the tree.
  host-clean)
    locate "$2" "$3"
    [ "$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null)" != true ] || { echo "cloud: the run is still going — stop it in the Claude app first" >&2; exit 3; }
    [ ! -e "$worktree" ] || [ -z "$(git -C "$worktree" status --porcelain)" ] || { echo "cloud: $worktree holds uncommitted work — commit or discard it on the host first" >&2; exit 3; }
    docker rm -f "$name" >/dev/null 2>&1 || true
    compose down -v --remove-orphans
    [ ! -e "$worktree" ] || git -C "$dir/repo.git" worktree remove --force "$worktree"
    git -C "$dir/repo.git" worktree prune
    rm -rf "$run.input" "$run.prompt" "$dir/inputs/${run##*/}"
    echo "host: $name, its services, volumes and worktree removed"
    exit 0 ;;

  # session <project> <branch>: the agent container's command. Turn the sandbox
  # off (the container is the boundary; on Linux the sandbox would put every
  # command in its own network namespace), register the chrome-devtools MCP,
  # launch claude --bg with Remote Control on the worktree, poll until it is
  # neither working nor blocked. On any exit, SIGTERM from docker stop included,
  # the session is stopped and removed; the commit is host-finish's job.
  session)
    locate "$2" "$3"
    cd "$worktree"
    node -e 'const fs=require("fs"),p=process.env.HOME+"/.claude/settings.json";const s=fs.existsSync(p)?JSON.parse(fs.readFileSync(p,"utf8")):{};s.sandbox={enabled:false};fs.writeFileSync(p,JSON.stringify(s,null,2)+"\n")'
    claude mcp get chrome-devtools >/dev/null 2>&1 || claude mcp add --scope user chrome-devtools -- chrome-devtools-mcp --headless --isolated --executablePath /usr/local/bin/chromium >/dev/null
    finish() {
      trap - EXIT TERM INT
      [ -z "${id:-}" ] || {
        case $(state_of "$id") in working|blocked|error) claude stop "$id" >/dev/null || true ;; esac
        claude rm "$id" >/dev/null || true
      }
    }
    trap finish EXIT
    trap 'exit 143' TERM INT
    stack="Bring the stack up yourself"
    [ ! -f "$dir/stack.yml" ] || stack="The services docker-compose.yml declares are already up under their service names, so do not start Docker; bring the rest of the stack up yourself"
    prompt=$(printf '%s\n' "This is a run of $project in its own container, and the app's configuration is in your environment." \
      "$stack, from the repository's own instructions, inside this worktree; stop what you started before you finish." \
      "Commit your work on this branch as you go, with real messages; do not push, the host does." "" "$(cat "$run.prompt")")
    id=$(claude --bg --name "$project/$branch" --remote-control "$project/$branch" --permission-mode auto "$prompt" |
         sed -n 's/^backgrounded · \([0-9a-f][0-9a-f]*\) .*/\1/p')
    [ -n "$id" ] || { echo "no session id" >&2; exit 1; }
    echo "session $id running"
    strikes=0
    while sleep "${POLL:-30}" & wait $!; do
      state=$(state_of "$id")
      case $state in
        working|blocked) strikes=0 ;;
        missing|error) [ $((strikes+=1)) -lt 3 ] || { echo "session $id is $state for claude agents --all, three times in a row" >&2; exit 1; } ;;
        *) break ;;
      esac
    done
    exit 0 ;;

  host-*) usage ;;
esac

# Client side from here: any machine with git, ssh and rsync. remote runs a host
# verb; target prefixes rsync destinations. CLOUD_HOST is the SSH alias of the
# host; empty, the host is this machine's own Docker.
tooling=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
claude_home=${CLAUDE_CONFIG_DIR:-$HOME/.claude}
if [ -n "$host" ]; then
  remote() { ssh "$host" "AGENT_ROOT=$root bash $root/cloud $(printf '%q ' "$@")"; }
  target=$host:
else
  remote() { bash "$root/cloud" "$@"; }
  target=
fi
case "${1:-}" in build|run|clean) ;; *) usage ;; esac
# Every verb ships the tooling and the client's Claude setup. The include filters
# mirror those entries and leave the rest of home/.claude alone: the login stays.
rsync -aq "$tooling/cloud" "$tooling/agent.yml" "$tooling/Dockerfile" "$target$root/"
rsync -aq --delete --include=settings.json --include='/rules/***' --include='/skills/***' --exclude='*' "$claude_home/" "$target$root/home/.claude/"
rsync -aq --delete --include=known_marketplaces.json --include='/marketplaces/***' --include='/cache/***' --exclude='*' "$claude_home/plugins/" "$target$root/seed/"
[ "${1:-}" != build ] || { remote host-build; exit; }

repo=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "cloud: not inside a git repository" >&2; exit 1; }
overlay=$repo/cloud.yml
[ -f "$overlay" ] || { echo "cloud: $overlay is missing — the agent service and this project's sidecars go there" >&2; exit 1; }
arg=${2:-}
[ -z "$arg" ] || [ ! -f "$arg" ] || rel=$(cd "$(dirname "$arg")" && git rev-parse --show-prefix)$(basename "$arg")
cd "$repo"
origin=$(git remote get-url origin 2>/dev/null) || { echo "cloud: no origin remote — the project is named after it and the pull request opens there" >&2; exit 1; }
locate "$(slug "$(basename -s .git "$origin")")" "$(git branch --show-current)"
url=$target$dir/repo.git
# The project's overlay and stack to the host, after the host agreed to the run.
# origin travels as https so gh's credential helper can push it.
ship() {
  remote host-check "$project" "$branch" "$([ -f docker-compose.yml ] && echo 1 || echo 0)" "$(printf '%s' "$origin" | sed -E 's#^git@github\.com:#https://github.com/#')"
  rsync -aq "$overlay" "$target$dir/"
  [ ! -f docker-compose.yml ] || rsync -aq docker-compose.yml "$target$dir/stack.yml"
}
# What the run gets besides the branch: .claude/ (briefs, plans, skills, ignored or not) and the file argument.
inputs() {
  local paths=()
  [ ! -d .claude ] || paths+=(.claude)
  [ -z "${rel:-}" ] || paths+=("./$rel")
  [ ${#paths[@]} = 0 ] || rsync -aqR --exclude worktrees "${paths[@]}" "$target$dir/inputs/${run##*/}/"
}

case "${1:-}" in
  # run <prompt|file>: from a clean tree on a branch. Push the branch to the
  # host's bare repository, ship the inputs, start the run. The result comes back
  # as a draft pull request on origin; nothing else to do here.
  run)
    [ -n "$arg" ] || usage
    [ -n "$branch" ] || { echo "cloud: detached HEAD — switch to a branch first" >&2; exit 1; }
    if [ "$branch" = main ]; then read -rp "branch? " branch; git switch -c "$branch"; locate "$project" "$branch"; fi
    [ -z "$(git status --porcelain)" ] || { echo "cloud: commit or stash first — the run starts from the branch as pushed:" >&2; git status --short >&2; exit 1; }
    ship
    git push -qf "$url" "HEAD:refs/heads/$branch"
    inputs
    prompt=${rel:+Implement $rel}; prompt=${prompt:-$arg}
    remote host-start "$project" "$branch" "$prompt"
    echo "running \"$prompt\" on $branch as $project/$branch"
    echo "follow it in the Claude app (Code → $project/$branch); a draft pull request opens on $branch when it ends"
    ;;

  # clean: remove the run of this branch from the host, for a run host-finish
  # could not end (its log says why) or one abandoned.
  clean)
    remote host-clean "$project" "$branch" && status=0 || status=$?
    [ "$status" != 3 ] || exit 1
    [ "$status" = 0 ] || { echo "cloud: host cleanup failed — \`cloud clean\` again once fixed" >&2; exit 1; }
    ;;
esac
